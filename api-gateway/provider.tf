terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 4.0"
    }
  }
}

provider "aws" {
  region = var.region
}

# token em CLOUDFLARE_API_TOKEN, para não passar por tfvars nem parar no state
provider "cloudflare" {}
